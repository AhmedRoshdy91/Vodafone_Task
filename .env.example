# Application Settings
APP_NAME=File Upload Service
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# Server Configuration
HOST=0.0.0.0
PORT=8000

# SQLite Configuration
SQLITE_DB_PATH=./data/fileservice.db

# MongoDB Configuration
# For Docker: use 'mongodb' (service name)
# For Local: use 'localhost'
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB=fileservice
MONGO_USER=mongo
MONGO_PASSWORD=mongo123

# Redis Configuration
# For Docker: use 'redis' (service name)
# For Local: use 'localhost'
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis123
REDIS_DB=0

# File Upload Settings (runtime only)
UPLOAD_DIR=./data/uploads

# Note: Application constants are defined in app/constants.py:
# - Pool sizes (MongoDB: 1-4, Redis: 4)
# - Cache sizes (Global: 100, Per-file: 20)
# - Cache TTL (3600 seconds)
# - Allowed extensions (txt, csv, log, json, xml)
# - Max file size (100 MB)
