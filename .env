# Application Settings
APP_NAME=File Upload Service
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# Server Configuration
HOST=0.0.0.0
PORT=8000

# SQLite Configuration
SQLITE_DB_PATH=./data/fileservice.db

# MongoDB Configuration (Docker service names)
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB=fileservice
MONGO_USER=mongo
MONGO_PASSWORD=mongo123

# Redis Configuration (Docker service names)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis123
REDIS_DB=0

# File Upload Settings (runtime only)
UPLOAD_DIR=./data/uploads
